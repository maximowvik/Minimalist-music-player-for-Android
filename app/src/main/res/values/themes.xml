<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Светлая тема (по умолчанию) -->
    <style name="Theme.MyMusicPlayer" parent="Theme.Material3.Light">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="colorPrimary">#6200EE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1C1B1F</item>
        <item name="colorSurfaceVariant">#E7E0EC</item>
        <item name="colorOnSurfaceVariant">#49454F</item>
        <item name="colorOutline">#79747E</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <!-- Темная тема (автоматически применяется системой) -->
    <style name="Theme.MyMusicPlayer.Dark" parent="Theme.Material3.Dark">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="colorPrimary">#BB86FC</item>
        <item name="colorOnPrimary">#3700B3</item>
        <item name="colorSurface">#121212</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorSurfaceVariant">#49454F</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="colorOutline">#938F99</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
    </style>
</resources>